#: app.py:181
#, python-format
msgid "App %(app_id)s not found"
msgstr "Appen %(app_id)s hittades inte"

#: app.py:184
msgid "You must be logged in to be able to star an app"
msgstr "Du måste vara inloggad för att kunna stjärnmärka en app"

#: app.py:187 app.py:232 app.py:660 templates/wishlist_add.html:33
msgid ""
"Note that, due to various abuses, we restricted login on the app store to "
"'trust level 1' users.<br/><br/>'Trust level 1' is obtained after "
"interacting a minimum with the forum, and more specifically: entering at "
"least 5 topics, reading at least 30 posts, and spending at least 10 minutes "
"reading posts."
msgstr ""
"Observera att vi på grund av olika former av missbruk har begränsat "
"inloggningen i appbutiken till användare med förtroendenivå 1.<br/><br/"
">Förtroendenivå 1 uppnås genom en viss minsta aktivitet på forumet, närmare "
"bestämt genom att öppna minst 5 ämnen, läsa minst 30 inlägg och ägna minst "
"10 minuter åt att läsa inlägg."

#: app.py:229
msgid "You must be logged in to submit an app to the wishlist"
msgstr "Du måste vara inloggad för att föreslå en app till önskelistan"

#: app.py:244
msgid "Invalid CSRF token, please refresh the page and try again"
msgstr "Ogiltig CSRF-token. Uppdatera sidan och försök igen"

#: app.py:283
msgid ""
"Proposing wishlist additions is limited to once every 15 days per user. "
"Please try again in a few days."
msgstr ""
"Förslag till önskelistan är begränsade till ett var 15:e dygn per användare. "
"Försök igen om några dagar."

#: app.py:286
msgid "App name should be at least 3 characters"
msgstr "Appnamnet måste bestå av minst 3 tecken"

#: app.py:287
msgid "App name should be less than 30 characters"
msgstr "Appnamnet måste bestå av färre än 30 tecken"

#: app.py:290
msgid "App description should be at least 5 characters"
msgstr "Appbeskrivningen måste bestå av minst 5 tecken"

#: app.py:294
msgid "App description should be less than 100 characters"
msgstr "Appbeskrivningen måste bestå av färre än 100 tecken"

#: app.py:298
msgid "Upstream code repo URL should be at least 10 characters"
msgstr ""
"URL:en till uppströmsprojektets kodförråd måste bestå av minst 10 tecken"

#: app.py:302
msgid "Upstream code repo URL should be less than 150 characters"
msgstr ""
"URL:en till uppströmsprojektets kodförråd måste bestå av färre än 150 tecken"

#: app.py:306
msgid "License URL should be at least 10 characters"
msgstr "Licens-URL:en måste bestå av minst 10 tecken"

#: app.py:310
msgid "License URL should be less than 250 characters"
msgstr "Licens-URL:en måste bestå av färre än 250 tecken"

#: app.py:312
msgid "Website URL should be less than 150 characters"
msgstr "Webbplatsens URL måste bestå av färre än 150 tecken"

#: app.py:315
msgid "App name contains special characters"
msgstr "Appnamnet innehåller specialtecken"

#: app.py:323
msgid ""
"Please focus on what the app does, without using marketing, fuzzy terms, or "
"repeating that the app is 'free' and 'self-hostable'. English language is "
"preferred."
msgstr ""
"Fokusera på vad appen gör utan marknadsföringsspråk, vaga formuleringar "
"eller upprepningar om att appen är ”fri” och ”självhostad”. Engelska "
"föredras."

#: app.py:332
msgid "No need to repeat the name of the app. Focus on what the app does."
msgstr "Du behöver inte upprepa appens namn. Fokusera på vad appen gör."

#: app.py:363
#, python-format
msgid ""
"An entry with the name %(slug)s already exists in the wishlist, instead, you "
"can <a href='%(url)s'>add a star to the app to show your interest</a>."
msgstr ""
"Det finns redan en post med namnet %(slug)s i önskelistan. Du kan i stället "
"<a href='%(url)s'>stjärnmärka appen för att visa ditt intresse</a>."

#: app.py:382
#, python-format
msgid ""
"We're sorry, but this app is listed among the already declined apps. The "
"specified reason is:<br /><q>%(reason)s</q>"
msgstr ""
"Tyvärr finns appen redan bland de avvisade apparna. Den angivna orsaken är:"
"<br /><q>%(reason)s</q>"

#: app.py:396
#, python-format
msgid ""
"An app with the name %(slug)s already exists in the catalog, <a "
"href='%(url)s'>you can see its page here</a>."
msgstr ""
"Det finns redan en app med namnet %(slug)s i katalogen. <a href='%(url)s'>Du "
"hittar appsidan här</a>."

#: app.py:421
#, python-format
msgid ""
"Failed to create the pull request to add the app to the wishlist… Maybe "
"there's already <a href='%(url)s'>a waiting PR for this app</a>? Else, "
"please report the issue to the YunoHost team."
msgstr ""
"Det gick inte att skapa pull requesten för att lägga till appen i "
"önskelistan … Det kanske redan finns <a href='%(url)s'>en väntande pull "
"request för appen</a>? Rapportera annars problemet till YunoHost-teamet."

#: app.py:471
#, python-format
msgid ""
"Your proposed app has succesfully been submitted. It must now be validated "
"by the YunoHost team. You can track progress here: <a "
"href='%(url)s'>%(url)s</a>"
msgstr ""
"Ditt appförslag har skickats in. Det måste nu godkännas av YunoHost-teamet. "
"Du kan följa förloppet här: <a href='%(url)s'>%(url)s</a>"

#: app.py:657
msgid "Unfortunately, login was denied."
msgstr "Inloggningen nekades tyvärr."

